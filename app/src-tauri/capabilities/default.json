  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lumen main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "dialog:allow-open",
    "global-shortcut:default"
  ]
}
