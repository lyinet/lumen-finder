<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri signs with the hardened runtime (also with the ad-hoc identity),
	     which blocks Apple Events unless this is set. Lumen needs it to ask
	     Finder to move files to the Trash (so Put Back works). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
