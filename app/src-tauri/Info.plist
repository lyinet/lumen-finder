<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into Lumen.app's Info.plist by tauri build. lumen://search?q=…,
	     lumen://ask?q=…, lumen://quick?q=… open Lumen on a search. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.lumen.desktop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lumen</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
